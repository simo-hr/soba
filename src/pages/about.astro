---
/**
 * Aboutページ
 *
 * @overview 自己紹介ページ
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="simoの自己紹介">
	<style slot="head">
		main {
			width: calc(100% - 2em);
			max-width: 100%;
			margin: 0;
		}
		.prose {
			width: 800px;
			max-width: calc(100% - 2em);
			margin: auto;
			padding: 1em;
			color: rgb(var(--gray-dark));
		}
		.prose h2 {
			font-size: 1.5em;
			margin-top: 2em;
			margin-bottom: 0.75em;
		}
	</style>

	<main>
		<div class="prose">
			<h2>simo</h2>
			<p>ソフトウェアエンジニア</p>

			<h2>好きなもの</h2>
			<p>キーボード / バスケ / 爬虫類 / フクロモモンガ / RPG / 龍が如く / ポケモン / ピクミン</p>
		</div>
	</main>
</BaseLayout>
