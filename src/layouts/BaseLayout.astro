---
/**
 * ベースレイアウト
 *
 * @overview 全ページ共通のHTML骨格（doctype / html / head / Header / Footer）を提供する
 * @specifications
 * - 本文は <slot /> で受け取る（<main> は各ページ側が持つ）
 * - ページ固有の <style> は各ページのコンポーネント内に書けば自動でバンドルされる
 */
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	/** OGP画像。省略時は BaseHead 側の FallbackImage が使われる */
	image?: ImageMetadata;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body>
		<Header />
		<slot />
		<Footer />
	</body>
</html>
